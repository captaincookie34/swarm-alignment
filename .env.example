# Copy to .env and fill in what you need: cp .env.example .env
# .env is in .gitignore. Never commit real keys. Variables you export in the shell win over this file.

# OpenRouter, the default: openrouter:anthropic/claude-opus-5.5, openrouter:qwen/qwen3.5-122b-a10b, ...
OPENROUTER_API_KEY=

# Optional direct providers, used only if you name them in --model
# Claude: anthropic:claude-opus-5-5
ANTHROPIC_API_KEY=
# Qwen through DashScope: alibaba:qwen-max
DASHSCOPE_API_KEY=
# Hugging Face: hf:<Hub repo ID>[:<provider>] through Inference Providers,
# or a dedicated endpoint: endpoint:<model>@https://<host>/v1
HF_TOKEN=
